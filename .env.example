# URL server-side menuju API publik tenant Django. Tidak pernah dikirim ke browser.
TENANT_API_URL=http://acme.localhost:8010/api/v1
TENANT_SITE_URL=http://localhost:3000
TENANT_REVALIDATE_SECONDS=30
TENANT_API_TIMEOUT_MS=8000
ENABLE_ONBOARDING_STUDIO=false
# Run only the onboarding UI without contacting a tenant API. Intended for the
# protected generator host, never for a generated public tenant website.
ONBOARDING_STANDALONE=false
